# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS) - IMPORTANT: Set this to your Vercel URL in production
FRONTEND_URL=http://localhost:5173

# Production Example:
# FRONTEND_URL=https://your-app.vercel.app

# Multiple origins (separate with commas if needed in production):
# FRONTEND_URL=https://your-app.vercel.app,https://www.your-app.vercel.app

# Database
MONGODB_URI=mongodb://localhost:27017/codechat
# REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
